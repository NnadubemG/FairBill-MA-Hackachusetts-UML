# Copy to .env and fill in. NEVER commit a real .env.
#
# Required only once the extract/letter handlers are implemented:
ANTHROPIC_API_KEY=
EXTRACT_MODEL_ID=
LETTER_MODEL_ID=
#
# Optional:
# Comma-separated exact origins for CORS. Leave empty for same-origin (default).
ALLOWED_ORIGINS=
# Port the server binds (Render injects PORT automatically; 8000 locally).
PORT=8000
